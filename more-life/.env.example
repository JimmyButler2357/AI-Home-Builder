# Postgres connection string (Supabase/Neon/local).
# For Supabase serverless deploys, use the transaction pooler (port 6543)
# and set DATABASE_NO_PREPARE=1.
DATABASE_URL=postgres://user:pass@localhost:5432/morelife
# DATABASE_NO_PREPARE=1

# Random long secret. Used to hash voter cookies into anonymous voter_hash
# values and to sign pair tokens. Changing it resets all voter identities.
APP_SECRET=change-me-to-a-long-random-string

# Password for the /admin review screen.
ADMIN_PASSWORD=change-me

# Optional: community-upload storage via Supabase Storage (a public bucket).
# Without these, uploads fall back to public/uploads in dev and are disabled
# in production.
# SUPABASE_URL=https://yourproject.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_STORAGE_BUCKET=community-images

# Self-hosted with a persistent disk? Set this to store uploads under
# public/uploads instead of object storage. Not for serverless platforms.
# ALLOW_LOCAL_UPLOADS=1
